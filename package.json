{
  "name": "creatorconnect",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorConnect — Multi-Sided Creator Economy Platform",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "vitest run --workspace=vitest.workspace.ts --fileParallelism=false --maxWorkers=1",
    "test:e2e": "turbo build --filter=@creatorconnect/database... && playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo clean && rimraf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@creatorconnect/database": "workspace:*",
    "@creatorconnect/utils": "workspace:*",
    "@playwright/test": "^1.46.0",
    "@types/node": "^20.14.12",
    "husky": "^9.1.7",
    "jose": "^5.9.6",
    "lint-staged": "^17.5.1",
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "undici": "^6.28.1",
      "proxy-addr": ">=2.0.8",
      "fast-uri": ">=3.1.8",
      "tinypool": ">=2.1.2",
      "postcss": ">=8.5.30",
      "source-map-js": ">=1.2.2",
      "sharp": ">=0.35.5",
      "brace-expansion": ">=2.1.7 <3.0.0",
      "@grpc/grpc-js": ">=1.14.6 <2.0.0",
      "next": "15.5.28"
    }
  }
}
