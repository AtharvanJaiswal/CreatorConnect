# ==============================================================================
# CreatorConnect — Environment Configuration Template (.env.example)
#
# CRITICAL SECURITY RULE:
# NEVER COMMIT REAL PRODUCTION OR STAGING SECRETS TO SOURCE CONTROL.
# Copy this file to .env.local for local development.
# ==============================================================================

# --- Node & Framework Environment ---
NODE_ENV=development
PORT=3000
REALTIME_PORT=3001
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Persistence & Cache (Docker Local) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorconnect_dev?schema=public
REDIS_URL=redis://localhost:6379/0

# --- Supabase Auth & Identity (Managed IdP) ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<public-anon-key>
SUPABASE_JWT_ISSUER=https://<your-project-ref>.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://<your-project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Cloudflare R2 Object Storage (Presigned Uploads) ---
R2_ACCOUNT_ID=<cloudflare-account-id>
R2_ACCESS_KEY_ID=<r2-access-key-id>
R2_SECRET_ACCESS_KEY=<r2-secret-access-key>
R2_BUCKET_NAME=creatorconnect-dev-media
R2_PUBLIC_DOMAIN=https://dev-media.creatorconnect.com

# --- Razorpay Payment Gateway (Test/Sandbox Mode) ---
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# --- Multi-Channel Notifications (FCM & Resend) ---
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_CLIENT_EMAIL=<firebase-service-account-email>
FIREBASE_PRIVATE_KEY="<firebase-private-key-multiline>"
RESEND_API_KEY=<resend-api-key>
EMAIL_FROM_ADDRESS=notifications@dev.creatorconnect.com

# --- Sentry Observability & Telemetry ---
SENTRY_DSN=https://<public-key>@sentry.io/<project-id>
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
