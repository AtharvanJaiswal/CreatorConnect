{
  "name": "@creatorconnect/worker",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorConnect Asynchronous Background Worker Service (BullMQ)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1132.0",
    "@creatorconnect/database": "workspace:^",
    "@creatorconnect/utils": "workspace:*",
    "@creatorconnect/validation": "workspace:*",
    "bullmq": "^5.8.6",
    "dotenv": "^16.4.5",
    "file-type": "^22.1.0",
    "ioredis": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "pino": "^9.4.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@creatorconnect/config": "workspace:*",
    "@types/node": "^20.14.12",
    "@types/sharp": "^0.32.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
