    "@creatorconnect/contracts": "workspace:*",
    "@creatorconnect/database": "workspace:*",
    "@creatorconnect/utils": "workspace:*",
    "@creatorconnect/validation": "workspace:*",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/sensible": "^5.5.0",
    "@fastify/swagger": "^8.15.0",
    "@scalar/fastify-api-reference": "^1.25.105",
    "@sinclair/typebox": "^0.33.7",
    "bullmq": "^5.8.6",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2"
