{
  "name": "@creatorconnect/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Shared testing utilities, factories, and Testcontainers helpers for CreatorConnect",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@creatorconnect/utils": "workspace:*",
    "@testcontainers/postgresql": "^10.13.2",
    "@testcontainers/redis": "^10.13.2",
    "testcontainers": "^10.13.2"
  },
  "devDependencies": {
    "@creatorconnect/config": "workspace:*",
    "@types/node": "^20.14.12",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
