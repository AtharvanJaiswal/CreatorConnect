datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleType {
  CREATOR
  PROFESSIONAL
  BRAND
  PODCASTER
  ADMIN
}

enum ProfileVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum BudgetType {
  FIXED
  RANGE
  HOURLY
}

enum MediaAssetStatus {
  QUARANTINED
  PENDING_SCAN
  ACTIVE
  REJECTED_INVALID
  DELETED
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum SkillProficiency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

// ==============================================================================
// Phase 5 Enums
// ==============================================================================

enum ConversationType {
  DIRECT
  GROUP
}

enum ParticipantRole {
  MEMBER
  ADMIN
}

enum MessageStatus {
  SENT
  EDITED
  DELETED
}

enum ReportCategory {
  SPAM
  HARASSMENT
  ABUSE
  SCAM
  INAPPROPRIATE_CONTENT
  MALICIOUS_FILE
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  WARN
  MUTE
  SUSPEND
  BAN
  CONTENT_REMOVED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

enum NotificationChannel {
  IN_APP
  PUSH
  EMAIL
}

enum NotificationType {
  MESSAGE_RECEIVED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  ASSIGNMENT_OFFER
  SYSTEM_ANNOUNCEMENT

  // Phase 6 Notification Types
  PROJECT_CREATED
  DELIVERABLE_SUBMITTED
  DELIVERABLE_APPROVED
  REVISION_REQUESTED
  PAYMENT_INTENT_SUCCEEDED
  PAYMENT_INTENT_FAILED
  ESCROW_RELEASED
  REFUND_PROCESSED
}

// ==============================================================================
// Phase 6 Enums: Projects & Deliverables
// ==============================================================================

enum ProjectStatus {
  IN_PROGRESS
  SUBMITTED
  REVISION_REQUESTED
  APPROVED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum DeliverableStatus {
  PENDING
  SUBMITTED
  IN_REVIEW
  APPROVED
  REVISION_REQUESTED
}

model User {
  id             String     @id @db.Uuid
  supabaseAuthId String     @unique @map("supabase_auth_id") @db.VarChar(64)
  email          String     @unique @db.VarChar(255)
  firstName      String?    @map("first_name") @db.VarChar(100)
  lastName       String?    @map("last_name") @db.VarChar(100)
  avatarUrl      String?    @map("avatar_url") @db.VarChar(512)
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  userRoles           UserRole[]
  auditLogs           AuditLog[]
  creatorProfile      CreatorProfile?
  professionalProfile ProfessionalProfile?
  brandProfile        BrandProfile?
  podcasterProfile    PodcasterProfile?
  userSkills          UserSkill[]
  portfolioItems      PortfolioItem[]
  mediaAssets         MediaAsset[]
  applications        Application[]
  statusHistories     ApplicationStatusHistory[]

  // Phase 5 Relations
  conversationParticipants  ConversationParticipant[]
  sentMessages              Message[]
  messageReactions          MessageReaction[]
  blocksInitiated           UserBlock[]               @relation("UserBlocksInitiated")
  blocksReceived            UserBlock[]               @relation("UserBlocksReceived")
  reports                   Report[]
  moderationActionsTaken    ModerationAction[]        @relation("ModerationActionsTaken")
  moderationActionsReceived ModerationAction[]        @relation("ModerationActionsReceived")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]

  // Phase 6 Relations
  clientProjects            Project[]                 @relation("ClientProjects")
  talentProjects            Project[]                 @relation("TalentProjects")
  clientPaymentIntents      PaymentIntent[]           @relation("ClientPaymentIntents")
  ledgerAccounts            LedgerAccount[]           @relation("UserLedgerAccounts")

  @@index([email])
  @@index([supabaseAuthId])
  @@map("users")
}

model Role {
  id          String   @id @db.Uuid
  name        RoleType @unique
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditLog {
  id        String   @id @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(64)
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(512)
  metadata  Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ==============================================================================
// Taxonomy
// ==============================================================================

model Category {
  id          String   @id @db.Uuid
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  creatorProfiles CreatorProfileCategory[]
  assignments     Assignment[]

  @@map("categories")
}

model Skill {
  id        String   @id @db.Uuid
  slug      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id          String           @id @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  skillId     String           @map("skill_id") @db.Uuid
  proficiency SkillProficiency @default(INTERMEDIATE)
  createdAt   DateTime         @default(now()) @map("created_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  @@map("user_skills")
}

// ==============================================================================
// Profiles
// ==============================================================================

model CreatorProfile {
  id              String            @id @db.Uuid
  userId          String            @unique @map("user_id") @db.Uuid
  tagline         String?           @db.VarChar(160)
  bio             String?           @db.Text
  locationCountry String?           @map("location_country") @db.VarChar(2)
  locationCity    String?           @map("location_city") @db.VarChar(100)
  isRemote        Boolean           @default(true) @map("is_remote")
  startingRate    Int?              @map("starting_rate")
  currency        String            @default("INR") @db.VarChar(3)
  visibility      ProfileVisibility @default(PUBLIC)
  isVerified      Boolean           @default(false) @map("is_verified")
  socialLinks     Json?             @map("social_links") @db.JsonB
  completionScore Int               @default(0) @map("completion_score")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories CreatorProfileCategory[]

  @@index([visibility, deletedAt])
  @@index([locationCountry, locationCity])
  @@map("creator_profiles")
}

model CreatorProfileCategory {
  creatorProfileId String @map("creator_profile_id") @db.Uuid
  categoryId       String @map("category_id") @db.Uuid

  creatorProfile CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  category       Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([creatorProfileId, categoryId])
  @@map("creator_profile_categories")
}

model ProfessionalProfile {
  id              String            @id @db.Uuid
  userId          String            @unique @map("user_id") @db.Uuid
  headline        String?           @db.VarChar(160)
  bio             String?           @db.Text
  yearsExperience Int?              @map("years_experience")
  dayRate         Int?              @map("day_rate")
  currency        String            @default("INR") @db.VarChar(3)
  isAvailable     Boolean           @default(true) @map("is_available")
  visibility      ProfileVisibility @default(PUBLIC)
  locationCountry String?           @map("location_country") @db.VarChar(2)
  locationCity    String?           @map("location_city") @db.VarChar(100)
  equipmentList   String[]          @default([]) @map("equipment_list")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, deletedAt])
  @@index([isAvailable])
  @@map("professional_profiles")
}

model BrandProfile {
  id          String            @id @db.Uuid
  userId      String            @unique @map("user_id") @db.Uuid
  companyName String            @map("company_name") @db.VarChar(150)
  industry    String?           @db.VarChar(100)
  websiteUrl  String?           @map("website_url") @db.VarChar(512)
  companySize String?           @map("company_size") @db.VarChar(32)
  bio         String?           @db.Text
  isVerified  Boolean           @default(false) @map("is_verified")
  visibility  ProfileVisibility @default(PUBLIC)
  deletedAt   DateTime?         @map("deleted_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments Assignment[]

  @@index([visibility, deletedAt])
  @@map("brand_profiles")
}

model PodcasterProfile {
  id              String            @id @db.Uuid
  userId          String            @unique @map("user_id") @db.Uuid
  podcastName     String            @map("podcast_name") @db.VarChar(150)
  description     String?           @db.Text
  rssFeedUrl      String?           @map("rss_feed_url") @db.VarChar(512)
  guestGuidelines String?           @map("guest_guidelines") @db.Text
  visibility      ProfileVisibility @default(PUBLIC)
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([visibility, deletedAt])
  @@map("podcaster_profiles")
}

// ==============================================================================
// Portfolio & Media
// ==============================================================================

model PortfolioItem {
  id           String            @id @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  title        String            @db.VarChar(160)
  description  String?           @db.Text
  externalUrl  String?           @map("external_url") @db.VarChar(512)
  displayOrder Int               @default(0) @map("display_order")
  visibility   ProfileVisibility @default(PUBLIC)
  tags         String[]          @default([])
  deletedAt    DateTime?         @map("deleted_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  media PortfolioMedia[]

  @@index([userId, displayOrder])
  @@index([visibility, deletedAt])
  @@map("portfolio_items")
}

model PortfolioMedia {
  id              String   @id @db.Uuid
  portfolioItemId String   @map("portfolio_item_id") @db.Uuid
  mediaAssetId    String   @map("media_asset_id") @db.Uuid
  displayOrder    Int      @default(0) @map("display_order")
  caption         String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")

  portfolioItem PortfolioItem @relation(fields: [portfolioItemId], references: [id], onDelete: Cascade)
  mediaAsset    MediaAsset    @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([portfolioItemId, mediaAssetId])
  @@index([portfolioItemId, displayOrder])
  @@map("portfolio_media")
}

model MediaAsset {
  id           String           @id @db.Uuid
  userId       String           @map("user_id") @db.Uuid
  storageKey   String           @unique @map("storage_key") @db.VarChar(512)
  thumbnailKey String?          @map("thumbnail_key") @db.VarChar(512)
  previewKey   String?          @map("preview_key") @db.VarChar(512)
  originalName String           @map("original_name") @db.VarChar(255)
  mimeType     String           @map("mime_type") @db.VarChar(100)
  byteSize     Int              @map("byte_size")
  mediaType    MediaType        @map("media_type")
  status       MediaAssetStatus @default(QUARANTINED)
  expiresAt    DateTime?        @map("expires_at")
  width        Int?
  height       Int?
  durationSec  Int?             @map("duration_sec")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolioMedia     PortfolioMedia[]
  messageAttachments MessageAttachment[]
  deliverables       ProjectDeliverable[]

  @@index([userId])
  @@index([status])
  @@map("media_assets")
}

// ==============================================================================
// Assignments (Strictly Brand-Owned in Phase 4)
// ==============================================================================

model Assignment {
  id          String           @id @db.Uuid
  brandId     String           @map("brand_id") @db.Uuid
  categoryId  String?          @map("category_id") @db.Uuid
  title       String           @db.VarChar(200)
  description String           @db.Text
  budgetType  BudgetType       @default(FIXED) @map("budget_type")
  budgetMin   Int              @map("budget_min")
  budgetMax   Int              @map("budget_max")
  currency    String           @default("INR") @db.VarChar(3)
  deadline    DateTime         @db.Timestamptz(3)
  isRemote    Boolean          @default(true) @map("is_remote")
  location    String?          @db.VarChar(150)
  status      AssignmentStatus @default(DRAFT)
  version     Int              @default(1)
  deletedAt   DateTime?        @map("deleted_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  brand         BrandProfile            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category      Category?               @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  requirements  AssignmentRequirement[]
  applications  Application[]
  conversations Conversation[]
  projects      Project[]

  @@index([status, deletedAt, createdAt])
  @@index([brandId])
  @@index([categoryId])
  @@index([budgetMin, budgetMax])
  @@map("assignments")
}

model AssignmentRequirement {
  id           String   @id @db.Uuid
  assignmentId String   @map("assignment_id") @db.Uuid
  title        String   @db.VarChar(150)
  isMandatory  Boolean  @default(true) @map("is_mandatory")
  createdAt    DateTime @default(now()) @map("created_at")

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@map("assignment_requirements")
}

// ==============================================================================
// Applications
// ==============================================================================

model Application {
  id           String            @id @db.Uuid
  assignmentId String            @map("assignment_id") @db.Uuid
  applicantId  String            @map("applicant_id") @db.Uuid
  coverLetter  String            @map("cover_letter") @db.Text
  proposedRate Int               @map("proposed_rate")
  currency     String            @default("INR") @db.VarChar(3)
  durationDays Int?              @map("duration_days")
  status       ApplicationStatus @default(SUBMITTED)
  version      Int               @default(1)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  assignment    Assignment                 @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  applicant     User                       @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  history       ApplicationStatusHistory[]
  conversations Conversation[]
  project       Project?

  @@unique([assignmentId, applicantId])
  @@index([assignmentId, status])
  @@index([applicantId, status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String            @id @db.Uuid
  applicationId String            @map("application_id") @db.Uuid
  fromStatus    ApplicationStatus @map("from_status")
  toStatus      ApplicationStatus @map("to_status")
  actorId       String            @map("actor_id") @db.Uuid
  reason        String?           @db.VarChar(255)
  createdAt     DateTime          @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([applicationId, createdAt])
  @@index([actorId])
  @@map("application_status_history")
}

// ==============================================================================
// Phase 5 Models
// ==============================================================================

model Conversation {
  id              String           @id @db.Uuid
  type            ConversationType @default(DIRECT)
  title           String?          @db.VarChar(150)
  assignmentId    String?          @map("assignment_id") @db.Uuid
  applicationId   String?          @map("application_id") @db.Uuid
  currentSequence BigInt           @default(0) @map("current_sequence")
  deletedAt       DateTime?        @map("deleted_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  assignment   Assignment?               @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  application  Application?              @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([deletedAt, createdAt])
  @@index([assignmentId])
  @@index([applicationId])
  @@map("conversations")
}

model ConversationParticipant {
  id               String          @id @db.Uuid
  conversationId   String          @map("conversation_id") @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  role             ParticipantRole @default(MEMBER)
  lastReadSequence BigInt          @default(0) @map("last_read_sequence")
  mutedUntil       DateTime?       @map("muted_until")
  leftAt           DateTime?       @map("left_at")
  joinedAt         DateTime        @default(now()) @map("joined_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, leftAt])
  @@index([conversationId, lastReadSequence])
  @@map("conversation_participants")
}

model Message {
  id              String        @id @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  senderId        String        @map("sender_id") @db.Uuid
  sequence        BigInt
  clientMessageId String        @map("client_message_id") @db.VarChar(64)
  content         String        @db.Text
  status          MessageStatus @default(SENT)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation(fields: [senderId], references: [id], onDelete: Restrict)
  attachments  MessageAttachment[]
  reactions    MessageReaction[]

  @@unique([conversationId, sequence])
  @@unique([senderId, conversationId, clientMessageId])
  @@index([conversationId, sequence(sort: Desc)])
  @@index([senderId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id           String   @id @db.Uuid
  messageId    String   @map("message_id") @db.Uuid
  mediaAssetId String   @map("media_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  message    Message    @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([messageId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  emoji     String   @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model UserBlock {
  id        String   @id @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("user_blocks")
}

model Report {
  id         String         @id @db.Uuid
  reporterId String         @map("reporter_id") @db.Uuid
  targetType String         @map("target_type") @db.VarChar(32) // USER, MESSAGE, ASSIGNMENT
  targetId   String         @map("target_id") @db.Uuid
  category   ReportCategory
  details    String         @db.Text
  status     ReportStatus   @default(PENDING)
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

model ModerationAction {
  id           String               @id @db.Uuid
  moderatorId  String               @map("moderator_id") @db.Uuid
  targetUserId String               @map("target_user_id") @db.Uuid
  actionType   ModerationActionType @map("action_type")
  reason       String               @db.Text
  expiresAt    DateTime?            @map("expires_at")
  createdAt    DateTime             @default(now()) @map("created_at")

  moderator  User @relation("ModerationActionsTaken", fields: [moderatorId], references: [id], onDelete: Restrict)
  targetUser User @relation("ModerationActionsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([targetUserId, createdAt])
  @@index([moderatorId])
  @@map("moderation_actions")
}

model OutboxEvent {
  id            String       @id @db.Uuid
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(64)
  aggregateId   String       @map("aggregate_id") @db.Uuid
  payload       Json         @db.JsonB
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  lastError     String?      @map("last_error") @db.Text
  publishedAt   DateTime?    @map("published_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId      String   @map("event_id") @db.Uuid
  consumerName String   @map("consumer_name") @db.VarChar(64)
  processedAt  DateTime @default(now()) @map("processed_at")

  @@id([eventId, consumerName])
  @@index([processedAt])
  @@map("processed_events")
}

model Notification {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  eventId   String?          @map("event_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.Text
  data      Json?            @db.JsonB
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([eventId])
  @@map("notifications")
}

model NotificationPreference {
  id      String              @id @db.Uuid
  userId  String              @map("user_id") @db.Uuid
  type    NotificationType
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, channel])
  @@index([userId])
  @@map("notification_preferences")
}

// ==============================================================================
// Phase 6 Models: Projects & Deliverables
// ==============================================================================

model Project {
  id            String        @id @db.Uuid
  assignmentId  String        @map("assignment_id") @db.Uuid
  applicationId String        @unique @map("application_id") @db.Uuid
  clientId      String        @map("client_id") @db.Uuid
  talentId      String        @map("talent_id") @db.Uuid
  title         String        @db.VarChar(200)
  description   String?       @db.Text
  totalAmount   Int           @map("total_amount")
  currency      String        @default("INR") @db.VarChar(3)
  status        ProjectStatus @default(IN_PROGRESS)
  version       Int           @default(1)
  startedAt     DateTime      @default(now()) @map("started_at")
  completedAt   DateTime?     @map("completed_at")
  cancelledAt   DateTime?     @map("cancelled_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  assignment   Assignment           @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  application  Application          @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  client       User                 @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  talent       User                 @relation("TalentProjects", fields: [talentId], references: [id], onDelete: Restrict)
  deliverables   ProjectDeliverable[]
  paymentIntents PaymentIntent[]
  ledgerAccounts LedgerAccount[]

  @@index([clientId, status])
  @@index([talentId, status])
  @@index([assignmentId])
  @@map("projects")
}

model ProjectDeliverable {
  id               String            @id @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  title            String            @db.VarChar(150)
  description      String?           @db.Text
  amount           Int
  dueDate          DateTime?         @map("due_date") @db.Timestamptz(3)
  status           DeliverableStatus @default(PENDING)
  version          Int               @default(1)
  submittedAssetId String?           @map("submitted_asset_id") @db.Uuid
  submissionNotes  String?           @map("submission_notes") @db.Text
  revisionNotes    String?           @map("revision_notes") @db.Text
  submittedAt      DateTime?         @map("submitted_at")
  approvedAt       DateTime?         @map("approved_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedAsset MediaAsset?     @relation(fields: [submittedAssetId], references: [id], onDelete: SetNull)
  paymentIntents PaymentIntent[]

  @@index([projectId, status])
  @@index([submittedAssetId])
  @@map("project_deliverables")
}

// ==============================================================================
// Phase 6 Increment 2: Financial, Ledger & Payment Models
// ==============================================================================

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  REQUIRES_CAPTURE
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  SANDBOX_MOCK
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model PaymentIntent {
  id                String          @id @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  deliverableId     String?         @map("deliverable_id") @db.Uuid
  clientId          String          @map("client_id") @db.Uuid
  amount            Int
  currency          String          @default("INR") @db.VarChar(3)
  platformFee       Int             @default(0) @map("platform_fee")
  status            PaymentStatus   @default(REQUIRES_PAYMENT_METHOD)
  provider          PaymentProvider @default(SANDBOX_MOCK)
  providerOrderId   String?         @map("provider_order_id") @db.VarChar(128)
  providerPaymentId String?         @map("provider_payment_id") @db.VarChar(128)
  idempotencyKey    String?         @map("idempotency_key") @db.VarChar(128)
  clientSecret      String?         @map("client_secret") @db.VarChar(255)
  errorMessage      String?         @map("error_message") @db.Text
  version           Int             @default(1)
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  project            Project             @relation(fields: [projectId], references: [id], onDelete: Restrict)
  deliverable        ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  client             User                @relation("ClientPaymentIntents", fields: [clientId], references: [id], onDelete: Restrict)
  ledgerTransactions LedgerTransaction[]

  @@index([clientId, status])
  @@index([projectId, status])
  @@index([provider, providerOrderId])
  @@index([provider, providerPaymentId])
  @@index([idempotencyKey])
  @@map("payment_intents")
}

model LedgerAccount {
  id        String            @id @db.Uuid
  code      String            @unique @db.VarChar(128)
  name      String            @db.VarChar(150)
  type      LedgerAccountType
  currency  String            @default("INR") @db.VarChar(3)
  userId    String?           @map("user_id") @db.Uuid
  projectId String?           @map("project_id") @db.Uuid
  balance   BigInt            @default(0)
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user    User?         @relation("UserLedgerAccounts", fields: [userId], references: [id], onDelete: SetNull)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  entries LedgerEntry[]

  @@index([userId])
  @@index([projectId])
  @@index([type])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id              String   @id @db.Uuid
  paymentIntentId String?  @map("payment_intent_id") @db.Uuid
  type            String   @db.VarChar(64)
  description     String?  @db.Text
  postedAt        DateTime @default(now()) @map("posted_at")
  createdAt       DateTime @default(now()) @map("created_at")

  paymentIntent PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  entries       LedgerEntry[]

  @@index([paymentIntentId])
  @@index([type, postedAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id            String               @id @db.Uuid
  transactionId String               @map("transaction_id") @db.Uuid
  accountId     String               @map("account_id") @db.Uuid
  direction     LedgerEntryDirection
  amount        Int
  currency      String               @default("INR") @db.VarChar(3)
  createdAt     DateTime             @default(now()) @map("created_at")

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     LedgerAccount     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("ledger_entries")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  key            String   @db.VarChar(128)
  scope          String   @db.VarChar(64)
  requestHash    String   @map("request_hash") @db.VarChar(64)
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  resourceId     String?  @map("resource_id") @db.VarChar(128)
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model PaymentWebhookEvent {
  id           String                  @id @db.Uuid
  provider     PaymentProvider
  eventId      String                  @map("event_id") @db.VarChar(128)
  eventType    String                  @map("event_type") @db.VarChar(128)
  payload      Json
  signature    String?                 @db.Text
  status       WebhookProcessingStatus @default(RECEIVED)
  processedAt  DateTime?               @map("processed_at")
  errorMessage String?                 @map("error_message") @db.Text
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@unique([provider, eventId])
  @@index([status, createdAt])
  @@map("payment_webhook_events")
}
